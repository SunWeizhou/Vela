# Vela Backend — Environment Configuration
# Copy to .env and fill in your values

# JWT secret key (generate with: openssl rand -base64 64)
JWT_SECRET=replace-with-at-least-32-random-characters

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-6

# Database
# SQLite (default, local dev): no extra config needed
# PostgreSQL (production): set DATABASE_URL
# DATABASE_URL=postgresql://user:password@host:5432/vela

# Server
PORT=8080
HOSTNAME=0.0.0.0

# Logging
LOG_LEVEL=info
